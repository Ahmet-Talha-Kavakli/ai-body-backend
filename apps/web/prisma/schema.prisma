model Medication {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dosage          String          // "1 tablet", "5ml", "10mg" gibi
  unit            String          @default("tablet") // tablet | ml | mg | sprey | damla
  type            String          @default("tablet") // tablet | kapsul | surup | damla | sprey | igne | krem | toz
  color           String          @default("#5E5CE6") // ilaç rengi (kullanıcı seçer)
  notes           String?         // doktor notu, yan etki vs.

  // Sıklık modeli — supplement'taki gibi
  scheduleMode    String          @default("fixed_times") // fixed_times | interval_hours | as_needed
  scheduleTimes   String[]        @default([]) // ["08:00", "14:00", "22:00"]
  scheduleDays    Int[]           @default([]) // [1,2,3,4,5,6,7] — boş = her gün, 1=Pzt
  intervalHours   Int?            // scheduleMode=interval_hours için (örn. her 8 saatte)

  // Tarih aralığı
  startDate       DateTime        @default(now())
  endDate         DateTime?       // null = süresiz

  // Stok takibi (opsiyonel)
  stockCount      Int?            // kalan tablet sayısı
  refillThreshold Int?            // bu sayının altına düşünce uyarı

  // Hatırlatıcı
  remindersOn     Boolean         @default(true)

  // Durum
  isActive        Boolean         @default(true)

  // Eski alan — geriye uyumluluk için tutuldu, yeni kod kullanmıyor
  frequency       String          @default("daily")
  reminderAt      String?

  // Soft-delete: silindiği tarih (null = aktif). Geçmiş tarihlerde hâlâ
  // bu tarihten önceyse listede görünür.
  deletedAt       DateTime?

  logs            MedicationLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, deletedAt])
}

model MedicationLog {
  id            String     @id @default(cuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt       DateTime   @default(now())
  date          String     @default("") // "2026-04-28" — günlük query için hızlı
  scheduledTime String?    // "08:00" — hangi zamanlanmış doza karşılık geldiği
  skipped       Boolean    @default(false)

  @@index([userId])
  @@index([userId, takenAt])
  @@index([userId, date])
  @@index([medicationId, date])
}

