// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ──────────────────────────────────────────
// USER & AUTH
// ──────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  name             String
  avatarUrl        String?
  subscriptionTier String    @default("free") // free | basic | standard | pro
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  healthProfile    HealthProfile?
  injuries         Injury[]
  programs         WorkoutProgram[]
  sessions         WorkoutSession[]
  mealLogs         MealLog[]
  nutritionGoal    NutritionGoal?
  wearableDevices  WearableDevice[]
  wearableReadings WearableReading[]
  conversations    AIConversation[]
  subscription     Subscription?
  weaknesses       UserWeakness[]

  // Phase 2: User profiling and analytics
  basicProfile     UserBasicProfile?
  healthMetrics    UserHealthMetrics?
  trainingHistory  UserTrainingHistory?
  nutritionMetrics UserNutritionMetrics?
  dailyMetrics     DailyMetrics[]

  // Social relations
  friends         UserFriend[]    @relation("UserFriends")
  friendOf        UserFriend[]    @relation("FriendOf")
  activities      UserActivity[]

  // V2: Memory embeddings
  memoryEmbeddings UserMemoryEmbedding[]

  // Social stats
  bio             String?
  profilePublic   Boolean         @default(false)

  // Phase 2: New relations for wearables, sleep, readiness
  wearables       Wearable[]      @relation("UserWearables")
  sleepRecords    SleepRecord[]   @relation("UserSleepRecords")
  readinessScores ReadinessScore[] @relation("UserReadinessScores")
  weeklySummaries WeeklySummary[] @relation("UserWeeklySummaries")
  bloodWorkRecords BloodWorkRecord[]

  @@index([clerkId])
  @@index([email])
}

model HealthProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                      Int
  gender                   String // male | female | other | prefer_not_to_say
  heightCm                 Float
  weightKg                 Float
  fitnessLevel             String // beginner | intermediate | advanced | elite
  goals                    String[] // array of FitnessGoal values
  availableDaysPerWeek     Int
  sessionDurationMinutes   Int
  availableEquipment       String[]
  updatedAt                DateTime @updatedAt

  @@index([userId])
}

model Injury {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyPart    String
  severity    String // mild | moderate | severe
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────
// WORKOUT PROGRAMS
// ──────────────────────────────────────────

model WorkoutProgram {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String        @default("")
  generatedByAi  Boolean       @default(false)
  aiVersion      String?
  isActive       Boolean       @default(false)
  status         ProgramStatus @default(ACTIVE)
  mesoCycleWeeks Int           @default(4)
  currentWeek    Int           @default(1)
  deloadWeek     Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  weeks          ProgramWeek[]
  sessions       WorkoutSession[]

  @@index([userId])
}

model ProgramWeek {
  id         String       @id @default(cuid())
  programId  String
  program    WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  days       ProgramDay[]

  @@index([programId])
}

model ProgramDay {
  id                       String            @id @default(cuid())
  weekId                   String
  week                     ProgramWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber                Int
  name                     String
  estimatedDurationMinutes Int               @default(45)
  notes                    String?
  exercises                PlannedExercise[]
  sessions                 WorkoutSession[]

  @@index([weekId])
}

model Exercise {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  muscleGroups     String[]
  equipment        String[]
  difficultyLevel  String
  videoUrl         String?
  thumbnailUrl     String?
  animationKey     String
  cues             String[]
  commonMistakes   String[]
  poseConfig       Json?             // PoseKeypointConfig

  // ExerciseDB integration
  externalId       String?           @unique
  bodyPart         String?
  target           String?
  secondaryMuscles String[]
  instructions     String[]
  gifUrl           String?

  plannedIn        PlannedExercise[]
  completedSets    CompletedSet[]

  @@index([slug])
}

model PlannedExercise {
  id              String     @id @default(cuid())
  dayId           String
  day             ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise   @relation(fields: [exerciseId], references: [id])
  sets            Int
  reps            Int?
  durationSeconds Int?
  restSeconds     Int        @default(60)
  rpe         Float?
  repsMin     Int     @default(8)
  repsMax     Int     @default(12)
  order       Int     @default(0)
  notes       String?

  @@index([dayId])
}

// ──────────────────────────────────────────
// WORKOUT SESSIONS
// ──────────────────────────────────────────

model WorkoutSession {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId        String?
  program          WorkoutProgram? @relation(fields: [programId], references: [id])
  programDayId     String?
  programDay       ProgramDay?    @relation(fields: [programDayId], references: [id])
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  durationSeconds  Int?
  overallFormScore Float?
  caloriesBurned   Float?
  notes            String?
  heartRateData    Json?          // HeartRateReading[]
  poseAnalyses     Json?          // PoseAnalysisSummary[]

  completedSets    CompletedSet[]
  formRepData      FormRepData[]  // NEW: Per-rep form analysis
  workoutAnalytics WorkoutAnalytics[]  // NEW: Analytics
  dailyMetrics     DailyMetrics[]

  @@index([userId])
  @@index([startedAt])
}

model CompletedSet {
  id              String         @id @default(cuid())
  sessionId       String
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber       Int
  reps            Int?
  weightKg        Float?
  durationSeconds Int?
  formScore       Float
  repData         Json           // RepData[]

  @@index([sessionId])
}

// ──────────────────────────────────────────
// NUTRITION
// ──────────────────────────────────────────

model MealLog {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt      DateTime   @default(now())
  mealType      String // breakfast | lunch | dinner | snack | pre_workout | post_workout
  items         Json       // FoodItem[]
  photoUrl      String?
  aiAnalyzed    Boolean    @default(false)
  totalCalories Float
  totalProteinG Float
  totalCarbsG   Float
  totalFatG     Float
  notes         String?

  @@index([userId])
  @@index([loggedAt])
}

model NutritionGoal {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories  Float
  proteinG       Float
  carbsG         Float
  fatG           Float
  waterMl        Float    @default(2500)
  generatedByAi  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// ──────────────────────────────────────────
// WEARABLES
// ──────────────────────────────────────────

model WearableDevice {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // apple_watch | garmin | fitbit | google_fit | samsung_health
  brand         String
  model         String
  isConnected   Boolean           @default(false)
  lastSyncedAt  DateTime?
  accessToken   String?           // encrypted

  readings      WearableReading[]

  @@index([userId])
}

model WearableReading {
  id          String         @id @default(cuid())
  deviceId    String
  device      WearableDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // heart_rate | steps | calories_burned | sleep_minutes | hrv | spo2
  value       Float
  unit        String
  recordedAt  DateTime

  @@index([userId])
  @@index([deviceId])
  @@index([recordedAt])
}

// ──────────────────────────────────────────
// AI CONVERSATIONS
// ──────────────────────────────────────────

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   String // program_generation | workout_coaching | nutrition_advice | health_assessment
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ──────────────────────────────────────────
// FORM ANALYSIS & ANALYTICS
// ──────────────────────────────────────────

// NEW TABLE: Store per-rep form analysis
model FormRepData {
  id               String         @id @default(cuid())
  sessionId        String
  session          WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseName     String
  repNumber        Int
  setNumber        Int

  // Pose data
  keypoints        Json           // Array of KeyPoint
  angles           Json           // AngleData

  // Analysis results
  formScore        Float
  technicalCorrectness Float
  errors           Json           // Array of FormError
  muscleEngagement Json           // MuscleEngagement map
  injuryRisk       Int            // 1-100

  // Coach feedback
  voiceFeedback    String
  corrections      String[]
  encouragement    String

  createdAt        DateTime       @default(now())

  @@index([sessionId])
  @@index([exerciseName])
  @@index([repNumber])
}

// NEW TABLE: Workout analytics aggregation
model WorkoutAnalytics {
  id               String         @id @default(cuid())
  sessionId        String         @unique
  session          WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  avgFormScore     Float
  bestRepScore     Float
  worstRepScore    Float
  formTrend        String         // "improving", "declining", "stable"
  muscleEngagement Json           // Aggregate muscle engagement
  weakPointsFound  String[]
  injuryRiskLevel  Int            // 1-100
  riskFactors      String[]

  createdAt        DateTime       @default(now())

  @@index([sessionId])
}

// NEW TABLE: User weaknesses tracking
model UserWeakness {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  muscleGroup      String         // "posterior_chain", "rear_delts", etc.
  exerciseName     String
  severity         Int            // 1-10
  discoveredDate   DateTime       @default(now())
  targetDate       DateTime?      // When to improve by

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([muscleGroup])
}

// ──────────────────────────────────────────
// PHASE 2: USER PROFILING & ANALYTICS
// ──────────────────────────────────────────

// User Profile - Basic Info
model UserBasicProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  age               Int
  gender            String    // Male, Female, Other, Prefer not to say
  height            Float     // cm
  weight            Float     // kg
  fitnessLevel      String    // Beginner, Intermediate, Advanced, Elite
  primaryGoal       String    // Weight Loss, Muscle Gain, Strength, etc
  experienceYears   Int
  targetWeight      Float?
  targetFitnessLevel String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

// Health & Injury Tracking
model UserHealthMetrics {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeInjuries    Json      // Array<{bodyPart, injuryType, severity, onsetDate, recoveryDeadline, restrictions}>
  pastInjuries      Json      // Array<{bodyPart, injuryType, onsetDate, recoveryDate, notes}>
  medicalRestrictions String[]
  currentPainPoints Json      // Array<{bodyPart, painLevel, occurrence}>
  doctorNotes       String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

// Training History
model UserTrainingHistory {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingDaysPerWeek Int
  preferredExercises  String[]
  dislikedExercises   String[]
  personalRecords     Json     // Array<{exercise, weight_kg, reps, date}>
  startingStats       Json     // {fitnessLevel, weight_kg, strengthBaseline}
  trainingStyle       String   // Push/Pull/Legs, Upper/Lower, Full Body, PPL, Bro Split
  preferredDuration   Int      // minutes

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// Nutrition & Recovery Targets
model UserNutritionMetrics {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  proteinTarget     Float     // grams/day
  calorieTarget     Int?
  dietType          String    // Omnivore, Vegetarian, Vegan, Keto, Paleo, Other
  avgSleepHours     Float
  stressLevel       Int       // 1-10
  alcoholConsumption String   // None, Occasional, Regular, Daily
  smoking           Boolean
  waterIntakeTarget Float     // liters/day
  supplementStack   String[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

// Daily Metrics - Post-workout check-in
model DailyMetrics {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  date              DateTime  @default(now())
  sleepHours        Float
  sleepQuality      Int       // 1-10
  stressLevel       Int       // 1-10
  proteinIntake     Float     // grams
  calorieIntake     Int?
  waterIntake       Float     // liters
  mood              String    // Excellent, Good, Neutral, Poor
  energyLevel       Int       // 1-10
  soreness          Int       // 1-10
  injuryPain        Int       // 1-10
  notes             String?

  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([date])
  @@index([sessionId])
}

// ──────────────────────────────────────────
// SOCIAL FEATURES
// ──────────────────────────────────────────

model UserFriend {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId        String
  friend          User      @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  status          String    @default("pending")  // pending, accepted, blocked
  requestedAt     DateTime  @default(now())
  acceptedAt      DateTime?

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
}

model UserActivity {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityType    String    // "workout_completed", "pr_achieved", "streak_milestone"
  description     String    // "Benched 120kg x5", "10 day streak"
  metadata        Json?     // {exercise, weight, reps, streak_days, formScore}

  createdAt       DateTime  @default(now())
  visibility      String    @default("friends_only")  // private, friends_only, public

  @@index([userId])
  @@index([createdAt])
  @@index([activityType])
  @@index([visibility])
}

model Leaderboard {
  id              String    @id @default(cuid())

  leaderboardType String    // "form_score", "most_consistent", "strongest", "best_recovery"
  period          String    // "weekly", "monthly", "all_time"

  entries         Json      // Array<{userId, username, score, rank, trend}>

  updatedAt       DateTime  @updatedAt

  @@unique([leaderboardType, period])
  @@index([leaderboardType])
  @@index([updatedAt])
}

// ──────────────────────────────────────────
// SUBSCRIPTION
// ──────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  tier                 String    @default("free") // free | basic | standard | pro
  status               String    @default("active") // active | canceled | past_due
  currentPeriodEnd     DateTime?
  monthlySessionsUsed  Int       @default(0)
  aiProgramsUsed       Int       @default(0)
  aiMealsUsed          Int       @default(0)
  aiCoachUsed          Int       @default(0)
  usageResetAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────
// V2: MEMORY EMBEDDINGS & CHALLENGE GROUPS
// ──────────────────────────────────────────

model UserMemoryEmbedding {
  id        String                       @id @default(cuid())
  userId    String
  content   String
  embedding Unsupported("vector(1536)")?
  type      MemoryType
  createdAt DateTime                     @default(now())
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChallengeGroup {
  id           String       @id @default(cuid())
  weekStart    DateTime
  ageRange     String
  fitnessLevel FitnessLevel
  goal         FitnessGoal
  avgSessions  Float        @default(0)
  memberCount  Int          @default(0)
  updatedAt    DateTime     @updatedAt
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum MemoryType {
  SESSION_SUMMARY
  WEEKLY_SUMMARY
  MILESTONE
  PATTERN
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
}

// ──────────────────────────────────────────
// PHASE 2: WEARABLES, SLEEP, READINESS, SUMMARIES
// ──────────────────────────────────────────

model Wearable {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserWearables", fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "APPLE_HEALTH", "GARMIN", "FITBIT"
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  isActive      Boolean  @default(false)
  connectedAt   DateTime @default(now())
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model SleepRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserSleepRecords", fields: [userId], references: [id], onDelete: Cascade)
  duration  Float    // minutes
  quality   Float    // 0-100
  recordedAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

model ReadinessScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserReadinessScores", fields: [userId], references: [id], onDelete: Cascade)
  score     Int      // 0-100
  source    String   // "SLEEP_SYNC", "MANUAL", etc.
  recordedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

model WeeklySummary {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("UserWeeklySummaries", fields: [userId], references: [id], onDelete: Cascade)
  totalWorkouts     Int
  totalVolume       Float
  averageFormScore  Float
  averageReadiness  Float
  topExercises      String[]
  weekStartDate     DateTime
  weekEndDate       DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([weekStartDate])
}

model BloodWorkRecord {
  id        String   @id @default(cuid())
  userId    String
  results   Json
  analysis  Json
  uploadedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
