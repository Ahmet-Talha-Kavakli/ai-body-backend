  score         String // green | yellow | red
  aiNote        String
  timing        String? // ne zaman alınır: "Sabah aç karnına", "Yemekle birlikte" vb.
  interactions  String? // ilaç/supplement etkileşimleri, virgülle ayrılmış
  allergens     String? // alerjen uyarıları, virgülle ayrılmış
  alternatives  String? // benzer alternatifler, virgülle ayrılmış
  evidenceLevel String? // Kuvvetli | Orta | Zayıf
  scoredAt      DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalog SupplementCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogId])
  @@index([userId])
  @@index([scoredAt])
