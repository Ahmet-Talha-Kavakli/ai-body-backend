  listName  String    @default("Market")
  checked   Boolean   @default(false)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, listName])
}

model PriceWatch {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserPriceWatches", fields: [userId], references: [id], onDelete: Cascade)
  productName String
  targetPrice Float
  currency    String    @default("TRY")
  active      Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Purchase {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserPurchases", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  currency  String    @default("TRY")
  store     String?
  category  String?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, category])
}
