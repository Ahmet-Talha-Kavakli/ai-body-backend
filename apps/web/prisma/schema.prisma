}

// ─── Activity Tracking ────────────────────────────────────────────────────────

model ActivityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityType String // "running" | "walking" | "swimming" | "sauna" | "cold_pool" | "tennis" | "padel" | "cycling" | "yoga" | "dance" | "football" | "basketball" | "other"
  subType      String? // alt tür key: "football_halisaha" | "swimming_pool" | vb.
  date         String // "YYYY-MM-DD" — supplement ile aynı pattern
  startTime    String? // "08:30" — günün saati
  duration     Int // dakika
  distance     Float? // km — sadece koşu/bisiklet için
  intensity    String   @default("medium") // "low" | "medium" | "high"
  calories     Int? // tahmini
  note         String?
  imageUrls    String[] @default([])
  comboTag     String? // "contrast_therapy" gibi — birleşik aktivite etiketleri
  isGoal       Boolean  @default(false) // günlük hedeften mi eklendi
  completed    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, activityType])
}

model ActivitySubType {
  id           String @id @default(cuid())
  activityType String // ana aktivite key'i: "football"
  key          String @unique // "football_halisaha"
  nametr       String // "Halısaha"
  nameen       String // "Futsal"
  metValue     Float // alt türe özgü MET katsayısı
  iconName     String // "football_halisaha" — activity-icons klasöründeki dosya adı (uzantısız)
  intensity    String @default("medium") // default yoğunluk

  @@index([activityType])
}

model UserActivityGoal {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMinutes Int      @default(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model ActivityCatalog {
  id            String   @id @default(cuid())
  activityType  String   @unique
  nametr        String // Türkçe isim
  nameen        String // İngilizce isim
  category      String // "cardio" | "water" | "recovery" | "sport" | "mind_body"
  metValue      Float // MET katsayısı (kalori hesabı için)
  hasDistance   Boolean  @default(false)
  iconName      String // Ionicons icon key
  color         String // hex renk
  descriptiontr String? // Kısa Türkçe tanım
  createdAt     DateTime @default(now())

  userScores UserActivityScore[]

  @@index([category])
}

model UserActivityScore {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId String
  catalog   ActivityCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  score     String // "green" | "yellow" | "red"
  aiNote    String
  benefits  String?
  cautions  String?
  frequency String? // "Haftada 3-4x ideal"
  bestTime  String? // "Sabah veya akşam"
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([userId, catalogId])
  @@index([userId])
  @@index([catalogId])
}

model UserPrivacySettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectWorkout   Boolean  @default(true)
  collectNutrition Boolean  @default(true)
  analytics        Boolean  @default(true)
  marketingEmails  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model DrinkCatalog {
  id                 String   @id @default(cuid())
  drinkType          String   @unique
  nametr             String
  nameen             String
  category           String // "water" | "tea" | "coffee" | "herbal" | "juice" | "sports" | "soda" | "other"
  hydrationValue     Float // 0-1 arası (1=tam hidrasyon, <0=negatif)
  caffeinePerServing Float? // mg
  sugarPerServing    Float? // g
  defaultServingMl   Int      @default(250)
  iconName           String
  color              String
  descriptiontr      String?
  createdAt          DateTime @default(now())

  userScores      UserDrinkScore[]
  userPreferences UserDrinkPreference[]

  @@index([category])
}

model UserDrinkPreference {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId    String
  catalog      DrinkCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  isVisible    Boolean      @default(true)
  // isHidden = swipe-to-delete ile listeden tamamen kaldırılmış catalog drink.
  // isVisible (toggle) ile ayrı: invisible hâlâ "İçeceklerim"de görünür, hidden değil.
  // PROTECTED catalog drink'leri (Su, Süt, Kola vb.) bu alana setlenmez — sunucu tarafı engeller.
  isHidden     Boolean      @default(false)
  sortOrder    Int          @default(0)
  customSizeMl Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  @@unique([userId, catalogId])
  @@index([userId])
}

model UserCustomDrink {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nametr             String
  nameen             String?
  category           String   @default("other")
  hydrationValue     Float    @default(1.0)
  caffeinePerServing Float?   @default(0)
  defaultServingMl   Int      @default(250)
  iconName           String
  color              String
  isVisible          Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([userId])
}

model UserDrinkScore {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId  String
  catalog    DrinkCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  score      String // "green" | "yellow" | "red"
  aiNote     String
  benefits   String?
  cautions   String?
  bestTime   String?
  dailyLimit String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@unique([userId, catalogId])
  @@index([userId])
}

model TrackingSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId         String? // nullable for free-run
  activityType    String // "running" | "walking" | "cycling"
  startedAt       DateTime
  endedAt         DateTime
  durationSec     Int
  distanceKm      Float
  paceSecPerKm    Float?
  avgSpeedKmh     Float?
  maxSpeedKmh     Float?
  steps           Int?
  elevationGain   Float?
  encodedPolyline String   @db.Text // Google polyline format
  // Optional raw samples (only kept if user opts in to detailed analysis)
  rawSamples      Json?
  createdAt       DateTime @default(now())

  splits TrackingSessionSplit[]

  @@index([userId])
  @@index([userId, startedAt])
}

model TrackingSessionSplit {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  km           Int
  durationSec  Int
  paceSecPerKm Float

  @@index([sessionId])
}

// ──────────────────────────────────────────
// BODY & MEDICAL PROFILE
// ──────────────────────────────────────────

// Body silhouette mark — replaces simple Injury (kept for migration).
// Represents anything visible on the body silhouette: injury, pain, scar,
// missing part, surgery site, tightness, chronic region.
model BodyMark {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String // body region slug, e.g. "biceps" | "chest" | "upper-back"
  side      String? // "left" | "right" | null
  type      String // "injury" | "pain" | "scar" | "missing" | "surgery" | "tightness" | "chronic_region"
  severity  Int // 1-4
  startDate DateTime
  endDate   DateTime?
  note      String    @default("")
  isActive  Boolean   @default(true)
  photos    String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Allergy {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String // "drug" | "food" | "environmental" | "contact" | "insect" | "other"
  severity     String // "mild" | "moderate" | "severe" | "anaphylactic"
  reactionType String?
  diagnosedAt  DateTime?
  hasEpiPen    Boolean   @default(false)
  isActive     Boolean   @default(true)
  note         String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model ChronicCondition {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String // "metabolic" | "cardiovascular" | "respiratory" | "digestive" | "musculoskeletal" | "neurological" | "autoimmune" | "hormonal" | "blood" | "mental" | "other"
  severity     String // "mild" | "moderate" | "severe"
  status       String // "active" | "remission" | "resolved"
  region       String? // body region slug if applicable
  diagnosedAt  DateTime
  doctorNote   String    @default("")
  nextCheckup  DateTime?
  photos       String[]  @default([])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Vaccination {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  doseNumber     Int       @default(1)
  administeredAt DateTime
  nextDoseAt     DateTime?
  notes          String    @default("")
  batchNumber    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Surgery {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  performedAt    DateTime
  region         String? // body region slug
  hospital       String?
  surgeon        String?
  recoveryNotes  String   @default("")
  photos         String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model FamilyHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation        String // "mother" | "father" | "sibling" | "grandparent" | "other"
  conditionName   String
  ageAtDiagnosis  Int?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model VisionHearing {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leftEyePower       Float?
  rightEyePower      Float?
  hasAstigmatism     Boolean   @default(false)
  usesContactLenses  Boolean   @default(false)
  lastEyeExam        DateTime?
  hearingLossLeft    Boolean   @default(false)
  hearingLossRight   Boolean   @default(false)
  usesHearingAid     Boolean   @default(false)
  lastHearingExam    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model DentalHealth {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasImplants     Boolean   @default(false)
  hasFillings     Boolean   @default(false)
  hasRootCanal    Boolean   @default(false)
  hasOrthodontics Boolean   @default(false)
  usesNightGuard  Boolean   @default(false)
  lastCheckup     DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model ChildhoodIllness {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String // e.g. "Measles", "Chickenpox"
  hadIllness    Boolean  @default(false)
  ageAtIllness  Int?
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model LifeState {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPregnant               Boolean   @default(false)
  pregnancyWeek            Int?
  dueDate                  DateTime?
  isBreastfeeding          Boolean   @default(false)
  hasDisability            Boolean   @default(false)
  disabilityType           String?
  accessibilityModeEnabled Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId])
}

model PhysicalProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  somatotype              String? // "ectomorph" | "mesomorph" | "endomorph"
  dominantHand            String? // "left" | "right" | "ambidextrous"
  hasHypoglycemia         Boolean  @default(false)
  hypoglycemiaNotes       String   @default("")
  hasFaintingHistory      Boolean  @default(false)
  faintingNotes           String   @default("")
  peakFlowMlMin           Int? // for asthma patients
  medicationSensitivities String[] @default([]) // e.g. ["opioid","benzodiazepine"]
  notes                   String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model EmergencyInfo {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodType                String? // "A+" | "A-" | "B+" | "B-" | "AB+" | "AB-" | "O+" | "O-"
  isOrganDonor             Boolean   @default(false)
  lastBloodDonation        DateTime?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  insuranceProvider        String?
  familyDoctor             String?
  nearestHospital          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId])
}

// ─── Substance Use / Bağımlılıklar ───────────────────────────────────────────
model Substance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // "smoking" | "alcohol" | "caffeine" | "vape" | "chewing_tobacco" | "cannabis" | "other"
  status       String    @default("active") // "active" | "quitting" | "quit"
  frequency    String? // "daily" | "weekly" | "occasional" | "rarely"
  amountPerDay Float? // sigara: paket/gün, alkol: birim/gün, kafein: bardak/gün
  unit         String? // "pack" | "drink" | "cup" | "ml" | "g" | "shot"
  startedAt    DateTime?
  quitDate     DateTime?
  note         String    @default("")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([userId, type])
}

// ─── Health Events / Geçici Hastalıklar ─────────────────────────────────────
model HealthEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String    // preset: "diarrhea" | "constipation" | "migraine" | "headache" | "nausea" | "fever" | "cough" | "dizziness" | "flu" | "stomachache" | "back_pain_episode" | "allergic_reaction" | "fatigue" | "other"
  customName  String?   // type="other" olduğunda kullanıcının yazdığı isim

  severity    Int       // 1-4 (1=hafif, 4=çok şiddetli)

  startDate   DateTime  // başlangıç (gün+saat)
  endDate     DateTime? // null = hâlâ devam ediyor

  triggers    String[]  @default([])  // ["food","stress","sleep","weather","menstruation","alcohol","caffeine","medication","exercise","unknown"]
  treatments  String[]  @default([])  // ["paracetamol","ibuprofen","antibiotic","rest","water","hot_compress","cold_compress","probiotic","doctor","other"]

  note        String    @default("")
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

// ────────────────────────────────────────────────────
// V2 (Faz N): Verim & Odak
// ────────────────────────────────────────────────────

model TaskProject {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("UserTaskProjects", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  color       String     @default("#5E5CE6")
  status      String     @default("active") // active | paused | done | archived
  deadline    DateTime?
  archived    Boolean    @default(false)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks       TaskItem[] @relation("ProjectTasks")

  @@index([userId, archived])
}

model TaskItem {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation("UserTaskItems", fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           TaskProject?   @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  parentTaskId      String?
  parentTask        TaskItem?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks          TaskItem[]     @relation("SubTasks")
  title             String
  description       String?        @db.Text
  status            String         @default("todo") // todo | in_progress | done | cancelled
  priority          String         @default("medium") // low | medium | high | urgent
  dueDate           DateTime?
  estimatedMinutes  Int?
  actualMinutes     Int?
  tags              String[]       @default([])
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  focusSessions     FocusSession[] @relation("FocusOnTask")
  timeBlocks        TimeBlock[]    @relation("BlockOnTask")

  @@index([userId, status])
  @@index([userId, dueDate])
}

model FocusSession {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation("UserFocusSessions", fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              TaskItem?      @relation("FocusOnTask", fields: [taskId], references: [id], onDelete: SetNull)
  taskTitle         String?        // Task yoksa direkt isim
  startedAt         DateTime       @default(now())
  endedAt           DateTime?
  plannedMinutes    Int            @default(25)
  actualMinutes     Int?
  // pomodoro | deep_work | review | reading | meeting | learning
  type              String         @default("pomodoro")
  completed         Boolean        @default(false)
  cancelled         Boolean        @default(false)
  distractionCount  Int            @default(0)
  environment       String?        // ev, ofis, kafe, kütüphane vb.
  energyBefore      Int?           // 1-5
  energyAfter       Int?           // 1-5
  note              String?        @db.Text
  createdAt         DateTime       @default(now())

  distractions      Distraction[]  @relation("SessionDistractions")

  @@index([userId, startedAt])
}

model Distraction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("UserDistractions", fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     FocusSession? @relation("SessionDistractions", fields: [sessionId], references: [id], onDelete: Cascade)
  source      String        // twitter, instagram, sms, telefon, kişi, diğer
  note        String?
  durationSec Int?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
}

model TimeBlock {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserTimeBlocks", fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      TaskItem? @relation("BlockOnTask", fields: [taskId], references: [id], onDelete: SetNull)
  label     String
  startTime DateTime
  endTime   DateTime
  // deep_work | meeting | break | exercise | meal | personal | other
  category  String    @default("deep_work")
  notes     String?
  iosEventId String?  // Eğer iOS Calendar'a da yazıldıysa
  createdAt DateTime  @default(now())

  @@index([userId, startTime])
}

model WeeklyReview {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation("UserWeeklyReviews", fields: [userId], references: [id], onDelete: Cascade)
  weekStart           DateTime
  weekEnd             DateTime
  productivityScore   Int?     // 0-100, AI auto-compute
  totalFocusMinutes   Int      @default(0)
  completedTasks      Int      @default(0)
  overdueTasks        Int      @default(0)
  totalDistractions   Int      @default(0)
  bestDay             String?  // monday, tuesday vb.
  worstDay            String?
