// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────
// USER & AUTH
// ──────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique
  email            String   @unique
  name             String
  avatarUrl        String?
  subscriptionTier String   @default("free") // free | basic | standard | pro
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  healthProfile    HealthProfile?
  injuries         Injury[]
  programs         WorkoutProgram[]
  sessions         WorkoutSession[]
  mealLogs         MealLog[]
  nutritionGoal    NutritionGoal?
  activeDietPlan   ActiveDietPlan?
  wearableDevices  WearableDevice[]
  wearableReadings WearableReading[]
  conversations    AIConversation[]
  subscription     Subscription?
  weaknesses       UserWeakness[]

  // Phase 2: User profiling and analytics
  basicProfile     UserBasicProfile?
  healthMetrics    UserHealthMetrics?
  trainingHistory  UserTrainingHistory?
  nutritionMetrics UserNutritionMetrics?
  dailyMetrics     DailyMetrics[]

  // Social relations
  friends    UserFriend[]   @relation("UserFriends")
  friendOf   UserFriend[]   @relation("FriendOf")
  activities UserActivity[]

  // V2: Memory embeddings
  memoryEmbeddings UserMemoryEmbedding[]

  // Social stats
  bio           String?
  profilePublic Boolean @default(false)

  // Settings fields
  timezone        String?
  country         String?
  locale          String? // "tr" | "en"
  privacySettings UserPrivacySettings?

  // Phase 2: New relations for wearables, sleep, readiness
  wearables            Wearable[]            @relation("UserWearables")
  sleepRecords         SleepRecord[]         @relation("UserSleepRecords")
  sleepSessions        SleepSession[]        @relation("UserSleepSessions")
  dreamConversations   DreamConversation[]   @relation("UserDreamConversations")

  // Seans AI — Yaşam Asistanı
  assistantProfile        AssistantProfile?       @relation("UserAssistantProfile")
  assistantConversations  AssistantConversation[] @relation("UserAssistantConversations")
  assistantMemoryFacts    AssistantMemoryFact[]   @relation("UserAssistantMemoryFacts")
  assistantPermissions    AssistantPermission[]   @relation("UserAssistantPermissions")
  healthKitSnapshots      HealthKitDailySnapshot[] @relation("UserHealthKitSnapshots")
  calendarEvents          CalendarEventShadow[]    @relation("UserCalendarEvents")
  reminderShadows         ReminderShadow[]         @relation("UserReminderShadows")
  contactShadows          ContactShadow[]          @relation("UserContactShadows")
  workoutShadows          WorkoutShadow[]          @relation("UserWorkoutShadows")
  transactions            Transaction[]            @relation("UserTransactions")
  financeSubscriptions    FinanceSubscription[]    @relation("UserFinanceSubscriptions")
  financialAccounts       FinancialAccount[]       @relation("UserFinancialAccounts")
  financialGoals          FinancialGoal[]          @relation("UserFinancialGoals")
  bills                   Bill[]                   @relation("UserBills")
  focusSessions           FocusSession[]           @relation("UserFocusSessions")
  taskItems               TaskItem[]               @relation("UserTaskItems")
  taskProjects            TaskProject[]            @relation("UserTaskProjects")
  timeBlocks              TimeBlock[]              @relation("UserTimeBlocks")
  distractions            Distraction[]            @relation("UserDistractions")
  weeklyReviews           WeeklyReview[]           @relation("UserWeeklyReviews")
  careerProfile           CareerProfile?           @relation("UserCareerProfile")
  workProjects            WorkProject[]            @relation("UserWorkProjects")
  meetingNotes            MeetingNote[]            @relation("UserMeetingNotes")
  jobApplications         JobApplication[]         @relation("UserJobApplications")
  achievements            Achievement[]            @relation("UserAchievements")
  workContacts            WorkContact[]            @relation("UserWorkContacts")
  careerGoals             CareerGoal[]             @relation("UserCareerGoals")
  books                   Book[]                   @relation("UserBooks")
  mediaItems              MediaItem[]              @relation("UserMediaItems")
  courses                 Course[]                 @relation("UserCourses")
  hobbies                 Hobby[]                  @relation("UserHobbies")
  hobbySessions           HobbySession[]           @relation("UserHobbySessions")
  learningGoals           LearningGoal[]           @relation("UserLearningGoals")
  freeNotes               FreeNote[]               @relation("UserFreeNotes")
  workoutPlans            WorkoutPlan[]            @relation("UserWorkoutPlans")
  trainingSessions        TrainingSession[]        @relation("UserTrainingSessions")
  exerciseSets            ExerciseSet[]            @relation("UserExerciseSets")
  personalRecords         PersonalRecord[]         @relation("UserPersonalRecords")
  races                   Race[]                   @relation("UserRaces")
  gearItems               GearItem[]               @relation("UserGearItems")
  trips                   Trip[]                   @relation("UserTrips")
  flights                 Flight[]                 @relation("UserFlights")
  lodgings                Lodging[]                @relation("UserLodgings")
  visitedPlaces           PlaceVisited[]           @relation("UserVisitedPlaces")
  packingItems            PackingItem[]            @relation("UserPackingItems")
  travelDocuments         TravelDocument[]         @relation("UserTravelDocuments")
  householdItems          HouseholdItem[]          @relation("UserHouseholdItems")
  chores                  Chore[]                  @relation("UserChores")
  maintenanceItems        MaintenanceItem[]        @relation("UserMaintenanceItems")
  vehicles                UserVehicle[]            @relation("UserVehicles")
  userPets                UserPet[]                @relation("UserPets")
  userPetEvents           UserPetEvent[]           @relation("UserPetEvents")
  homeAppointments        HomeAppointment[]        @relation("UserHomeAppointments")
  socialEvents            SocialEvent[]            @relation("UserSocialEvents")
  birthdays               Birthday[]               @relation("UserBirthdays")
  giftIdeas               GiftIdea[]               @relation("UserGiftIdeas")
  favors                  Favor[]                  @relation("UserFavors")
  socialNotes             SocialNote[]             @relation("UserSocialNotes")
  wishlistItems           WishlistItem[]           @relation("UserWishlistItems")
  groceryItems            GroceryItem[]            @relation("UserGroceryItems")
  priceWatches            PriceWatch[]             @relation("UserPriceWatches")
  purchases               Purchase[]               @relation("UserPurchases")
  people                  Person[]                @relation("UserPeople")
  lifeEvents              LifeEvent[]             @relation("UserLifeEvents")
  environment             EnvironmentContext?     @relation("UserEnvironment")
  assistantReminders      AssistantReminder[]     @relation("UserAssistantReminders")
  moodLogs                MoodLog[]               @relation("UserMoodLogs")
  readinessScores      ReadinessScore[]      @relation("UserReadinessScores")
  weeklySummaries      WeeklySummary[]       @relation("UserWeeklySummaries")
  bloodWorkRecords     BloodWorkRecord[]
  fitnessCoachSessions FitnessCoachSession[]
  characterMorphCache  Json?

  // Push notifications
  expoPushToken        String?
  pushTokenUpdatedAt   DateTime?
  notificationsEnabled Boolean   @default(true)
  quietHoursStart      Int?      // 0-23 (örn 22)
  quietHoursEnd        Int?      // 0-23 (örn 8)

  // Nutrition Hub Phase 1
  waterLogs         WaterLog[]
  waterSettings     WaterSettings?
  waterStreak       WaterStreak?
  drinkLogs         DrinkLog[]
  mealAnalyses      MealAnalysis[]
  nutritionStreak   NutritionStreak?
  dietProfile       DietProfile?
  mealTemplates     MealTemplate[]
  customFoods       CustomFood[]
  recipes           Recipe[]
  pantryItems       PantryItem[]
  shoppingList      ShoppingListItem[]
  favoriteFoods     FavoriteFood[]
  notificationPrefs NotificationPreference?
  notifications     Notification[]
  userAchievements  UserAchievement[]
  userXP            UserXP?
  weightEntries     WeightEntry[]
  healthGoal        HealthGoal?
  roadmap           Roadmap?

  allergies String[]

  supplements       Supplement[]
  supplementLogs    SupplementLog[]
  supplementScores  UserSupplementScore[]
  supplementRatings SupplementEffectRating[]
  activityLogs      ActivityLog[]
  activityScores    UserActivityScore[]
  activityGoal      UserActivityGoal?
  drinkScores       UserDrinkScore[]
  drinkPreferences  UserDrinkPreference[]
  customDrinks      UserCustomDrink[]
  medications       Medication[]
  medicationLogs    MedicationLog[]

  pet              Pet?
  petInteractions  PetInteraction[]
  healthMetricLogs HealthMetricLog[] @relation("UserHealthMetricLogs")

  trackingSessions TrackingSession[]

  // Body & Medical Profile
  bodyMarks          BodyMark[]
  allergyRecords     Allergy[]
  chronicConditions  ChronicCondition[]
  vaccinations       Vaccination[]
  surgeries          Surgery[]
  familyHistory      FamilyHistory[]
  visionHearing      VisionHearing?
  dentalHealth       DentalHealth?
  childhoodIllnesses ChildhoodIllness[]
  lifeState          LifeState?
  physicalProfile    PhysicalProfile?
  emergencyInfo      EmergencyInfo?
  substances         Substance[]
  healthEvents       HealthEvent[]

  @@index([clerkId])
  @@index([email])
}

model HealthProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                    Int
  gender                 String // male | female | other | prefer_not_to_say
  heightCm               Float
  weightKg               Float
  fitnessLevel           String // beginner | intermediate | advanced | elite
  goals                  String[] // array of FitnessGoal values
  availableDaysPerWeek   Int
  sessionDurationMinutes Int
  availableEquipment     String[]
  updatedAt              DateTime @updatedAt

  @@index([userId])
}

model Injury {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyPart    String
  severity    String // mild | moderate | severe
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────
// WORKOUT PROGRAMS
// ──────────────────────────────────────────

model WorkoutProgram {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String        @default("")
  generatedByAi  Boolean       @default(false)
  aiVersion      String?
  isActive       Boolean       @default(false)
  status         ProgramStatus @default(ACTIVE)
  mesoCycleWeeks Int           @default(4)
  currentWeek    Int           @default(1)
  deloadWeek     Int?
  weeklyPlanJson Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  weeks    ProgramWeek[]
  sessions WorkoutSession[]

  @@index([userId])
}

model ProgramWeek {
  id         String         @id @default(cuid())
  programId  String
  program    WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  days       ProgramDay[]

  @@index([programId])
}

model ProgramDay {
  id                       String            @id @default(cuid())
  weekId                   String
  week                     ProgramWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber                Int
  name                     String
  estimatedDurationMinutes Int               @default(45)
  notes                    String?
  exercises                PlannedExercise[]
  sessions                 WorkoutSession[]

  @@index([weekId])
}

model Exercise {
  id              String   @id @default(cuid())
  name            String
  nametr          String? // Turkish name
  slug            String   @unique
  description     String   @default("")
  muscleGroups    String[]
  equipment       String[]
  difficultyLevel String   @default("beginner")
  videoUrl        String?
  thumbnailUrl    String?
  animationKey    String   @default("")
  cues            String[]
  commonMistakes  String[]
  poseConfig      Json? // PoseKeypointConfig

  // ExerciseDB integration
  externalId       String?  @unique
  bodyPart         String?
  target           String?
  secondaryMuscles String[]
  instructions     String[]
  gifUrl           String?

  // Fitness categorization
  fitnessCategory String? // "evde" | "salonda" | "outdoor"

  plannedIn     PlannedExercise[]
  completedSets CompletedSet[]

  @@index([slug])
  @@index([fitnessCategory])
}

model PlannedExercise {
  id              String     @id @default(cuid())
  dayId           String
  day             ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise   @relation(fields: [exerciseId], references: [id])
  sets            Int
  reps            Int?
  durationSeconds Int?
  restSeconds     Int        @default(60)
  rpe             Float?
  repsMin         Int        @default(8)
  repsMax         Int        @default(12)
  order           Int        @default(0)
  notes           String?

  @@index([dayId])
}

// ──────────────────────────────────────────
// WORKOUT SESSIONS
// ──────────────────────────────────────────

model WorkoutSession {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId        String?
  program          WorkoutProgram? @relation(fields: [programId], references: [id])
  programDayId     String?
  programDay       ProgramDay?     @relation(fields: [programDayId], references: [id])
  date             String? // "YYYY-MM-DD" for easy filtering
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  durationSeconds  Int?
  overallFormScore Float?
  caloriesBurned   Float?
  notes            String?
  sessionName      String? // e.g. "Göğüs Antrenmanı"
  heartRateData    Json? // HeartRateReading[]
  poseAnalyses     Json? // PoseAnalysisSummary[]

  completedSets    CompletedSet[]
  formRepData      FormRepData[] // NEW: Per-rep form analysis
  workoutAnalytics WorkoutAnalytics[] // NEW: Analytics
  dailyMetrics     DailyMetrics[]

  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@index([userId, endedAt])
}

model CompletedSet {
  id              String         @id @default(cuid())
  sessionId       String
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber       Int
  reps            Int?
  weightKg        Float?
  durationSeconds Int?
  formScore       Float
  repData         Json // RepData[]

  @@index([sessionId])
  @@index([sessionId, exerciseId])
}

// ──────────────────────────────────────────
// NUTRITION
// ──────────────────────────────────────────

model MealLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt   DateTime @default(now())
  mealType   String // breakfast | lunch | dinner | snack
  items      Json // MealItem[] — { foodId?, customFoodId?, recipeId?, name, brand?, servingSize, servingUnit, quantity, calories, protein, carbs, fat, fiber, sugar, ... source: 'fatsecret'|'custom'|'recipe'|'ai'|'quick' }
  photoUrl   String?
  aiAnalyzed Boolean  @default(false)
  source     String   @default("manual") // manual | ai_photo | barcode | quick_add | template | smart_suggest

  // Toplam makrolar
  totalCalories Float
  totalProteinG Float
  totalCarbsG   Float
  totalFatG     Float

  // Toplam sub-makrolar
  totalFiberG        Float @default(0)
  totalSugarG        Float @default(0)
  totalAddedSugarG   Float @default(0)
  totalSatFatG       Float @default(0)
  totalMonoFatG      Float @default(0)
  totalPolyFatG      Float @default(0)
  totalTransFatG     Float @default(0)
  totalCholesterolMg Float @default(0)
  totalSodiumMg      Float @default(0)
  totalSaltMg        Float @default(0)
  totalAlcoholG      Float @default(0)

  // Toplam vitamin/mineral (cached for fast queries)
  totalMicros Json? // { vitA, vitC, vitD, vitE, vitK, b1, b2, b3, b6, b9, b12, Ca, Fe, Mg, P, K, Zn, Se, Cu, Mn }

  notes    String?
  analysis MealAnalysis?

  @@index([userId])
  @@index([loggedAt])
  @@index([userId, loggedAt])
  @@index([userId, mealType, loggedAt])
}

model NutritionGoal {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hedefler (günlük)
  dailyCalories Float
  proteinG      Float
  carbsG        Float
  fatG          Float

  // Mikro/sub makro hedefleri
  fiberG        Float    @default(25)
  sugarG        Float    @default(50) // limit
  addedSugarG   Float    @default(25) // limit
  saturatedFatG Float    @default(20) // limit
  transFatG     Float    @default(2)  // limit
  cholesterolMg Float    @default(300) // limit
  sodiumMg      Float    @default(2300) // limit
  saltMg        Float    @default(5750) // limit
  alcoholG      Float    @default(0)  // limit

  // Eski water alanları (legacy, ayrı sayfa)
  waterMl       Float    @default(2500)
  waterGoalMl   Float    @default(2500)

  // Hesaplama metadata
  bmr               Float? // Mifflin-St Jeor BMR
  tdee              Float? // Total Daily Energy Expenditure
  activityLevel     String? // sedentary | light | moderate | active | very_active
  goalType          String? // lose | maintain | gain | bulk
  weeklyWeightDelta Float? // -1.0 .. +1.0 kg/hafta
  targetWeightKg    Float?
  macroSplit        String?  @default("balanced") // balanced | high_protein | low_carb | keto | mediterranean | vegan | vegetarian
  generatedByAi     Boolean  @default(false)

  updatedAt     DateTime @updatedAt
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  glasses   Int      @default(0)
  loggedAt  DateTime @default(now())
  amountMl  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ──────────────────────────────────────────
// DIET PLANS — preset library + active plan + day menus
// ──────────────────────────────────────────

model DietPreset {
  id                  String   @id @default(cuid())
  slug                String   @unique // "mediterranean", "keto", "if-16-8"
  name                String
  tagline             String   // tek satır özet
  description         String   @db.Text
  heroImageUrl        String   // büyük detay/onboarding kart
  thumbnailUrl        String   // küçük liste kart
  accentColor         String   // #007AFF tarzı

  // Süre (kullanıcı seçicinin sınırları)
  defaultDurationDays Int
  minDurationDays     Int
  maxDurationDays     Int

  // Makro hesabı
  calorieFormula      String   // "fixed:1800" | "perKg:25" | "tdee:0.85"
  proteinPct          Int      // 30 (yüzde)
  carbsPct            Int
  fatPct              Int

  // Bilimsel meta
  evidenceLevel       String   // "strong" | "moderate" | "emerging"
  recommendedFor      String[] // ["kilo verme", "kalp sağlığı"]
  notRecommendedFor   String[] // ["hamileler", "böbrek hastaları"]

  // Kurallar + öğün havuzu
  rules               Json     // { allowed: string[], avoid: string[], tips: string[] }
  mealPool            Json     // { breakfast: PresetMeal[], lunch: [], dinner: [], snack: [] }

  // Sıralama
  popularityScore     Int      @default(0)
  isPremium           Boolean  @default(false)

  activePlans         ActiveDietPlan[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([popularityScore])
}

model ActiveDietPlan {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  presetId        String?  // null ise AI generated
  preset          DietPreset? @relation(fields: [presetId], references: [id])

  // Snapshot — preset değişse de plan donmuş kalır
  name            String
  accentColor     String
  heroImageUrl    String

  startedAt       DateTime @default(now())
  durationDays    Int
  endsAt          DateTime
  status          String   @default("active") // active | completed | stopped

  // Hedef snapshot
  dailyCalories   Int
  proteinG        Int
  carbsG          Int
  fatG            Int

  rules           Json
  mealPool        Json

  // AI plan ise
  aiGenerated     Boolean  @default(false)
  aiPreferences   Json?    // { goalType, allergens, dislikes }

  // Bırakınca NutritionGoal restore için
  previousGoalSnapshot Json?

  dayMenus        DietDayMenu[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
}

model DietDayMenu {
  id               String   @id @default(cuid())
  planId           String
  plan             ActiveDietPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  date             String   // "YYYY-MM-DD"
  mealType         String   // breakfast | lunch | dinner | snack
  items            Json     // [{ name, servingSize, servingUnit, quantity, calories, proteinG, carbsG, fatG }]
  totalCalories    Float
  totalProteinG    Float
  totalCarbsG      Float
  totalFatG        Float

  appliedAt        DateTime?
  appliedMealLogId String?

  createdAt        DateTime @default(now())

  @@unique([planId, date, mealType])
  @@index([planId, date])
}

model WaterSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGoalMl           Float    @default(2500)
  cupSizeMl             Float    @default(200)
  reminderMode          String   @default("interval") // "interval" | "manual"
  reminderIntervalHours Int      @default(2)
  reminderTimes         String[] @default([])
  isManualGoal          Boolean  @default(false)
  city                  String?
  tempBonusMl           Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model WaterStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastGoalDate    DateTime?
  totalDaysGoal   Int       @default(0)
  freezeCharges   Int       @default(0)
  freezeUsedDates String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model DrinkLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  drinkType String // category: "water" | "tea" | "coffee" | "herbal" | "juice" | "sports" | "dairy" | "smoothie" | "soda" | "alcohol" | "other"
  amountMl  Float
  catalogId String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ──────────────────────────────────────────
// FATSECRET INTEGRATION
// ──────────────────────────────────────────

model FoodItem {
  id            String   @id @default(cuid())
  fatSecretId   String   @unique // FatSecret API'den gelen food ID
  barcode       String?  @unique // EAN/UPC barkod
  brand         String?
  name          String
  nametr        String? // Türkçe ad (normalize)
  category      String? // protein | carb | fat | vegetable | fruit | dairy | drink | snack | other
  servingSize   Float    @default(100)
  servingUnit   String   @default("g") // g | ml | oz | cup | piece | slice | tbsp | tsp
  servingsPerContainer Float? // pakette kaç porsiyon var

  // Macros
  calories      Float
  proteinG      Float
  carbsG        Float
  fatG          Float

  // Detailed carbs/fats/etc
  fiberG        Float    @default(0)
  sugarG        Float    @default(0)
  addedSugarG   Float    @default(0)
  saturatedFatG Float    @default(0)
  monounsaturatedFatG Float @default(0)
  polyunsaturatedFatG Float @default(0)
  transFatG     Float    @default(0)
  cholesterolMg Float    @default(0)
  sodiumMg      Float    @default(0)
  saltMg        Float    @default(0)
  waterG        Float    @default(0)
  alcoholG      Float    @default(0)

  // Vitamins (13)
  vitaminAMcg   Float    @default(0)
  vitaminCMg    Float    @default(0)
  vitaminDMcg   Float    @default(0)
  vitaminEMg    Float    @default(0)
  vitaminKMcg   Float    @default(0)
  vitaminB1Mg   Float    @default(0) // tiamin
  vitaminB2Mg   Float    @default(0) // riboflavin
  vitaminB3Mg   Float    @default(0) // niasin
  vitaminB6Mg   Float    @default(0)
  vitaminB9Mcg  Float    @default(0) // folat
  vitaminB12Mcg Float    @default(0)

  // Minerals (9)
  calciumMg     Float    @default(0)
  ironMg        Float    @default(0)
  magnesiumMg   Float    @default(0)
  phosphorusMg  Float    @default(0)
  potassiumMg   Float    @default(0)
  zincMg        Float    @default(0)
  seleniumMcg   Float    @default(0)
  copperMg      Float    @default(0)
  manganeseMg   Float    @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fatSecretId])
  @@index([barcode])
  @@index([name])
}

// MealAnalysis: Fotoğraftan AI ile analiz sonuçları
model MealAnalysis {
  id             String   @id @default(cuid())
  mealLogId      String   @unique
  mealLog        MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl       String
  detectedFoods  Json // { name, calories, protein, carbs, fat, servingSize, confidence }[]
  analysisNotes  String?
  visionModel    String   @default("gpt-4o-mini") // Used model
  analysisTokens Int      @default(0) // Token cost tracking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model NutritionStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLogDate   DateTime?
  updatedAt     DateTime  @updatedAt
}

model DietProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("balanced")
  updatedAt DateTime @updatedAt
}

model MealTemplate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  mealType      String // breakfast | lunch | dinner | snack
  items         Json // MealItem[]
  totalCalories Int
  totalProteinG Float
  totalCarbsG   Float
  totalFatG     Float
  source        String   @default("user") // user | smart_suggest (Smart Adding)
  useCount      Int      @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, useCount])
}

// ──────────────────────────────────────────
// CUSTOM FOOD (kullanıcının kendi yarattığı yemekler)
// ──────────────────────────────────────────
model CustomFood {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  barcode     String?
  photoUrl    String?
  servingSize Float   @default(100)
  servingUnit String  @default("g")

  // Macros
  calories Float
  proteinG Float
  carbsG   Float
  fatG     Float

  // Sub-macros (opsiyonel)
  fiberG              Float @default(0)
  sugarG              Float @default(0)
  addedSugarG         Float @default(0)
  saturatedFatG       Float @default(0)
  monounsaturatedFatG Float @default(0)
  polyunsaturatedFatG Float @default(0)
  transFatG           Float @default(0)
  cholesterolMg       Float @default(0)
  sodiumMg            Float @default(0)
  saltMg              Float @default(0)
  waterG              Float @default(0)
  alcoholG            Float @default(0)

  // Mikro (opsiyonel — JSON kolaylığı için)
  micros Json? // { vitA, vitC, ... }

  isQuickAdd Boolean @default(false) // true = sadece sayılarla eklendi
  useCount   Int     @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // External source references — aynı kaynaktan gelen yemekleri tekilleştirmek için
  offCode         String? // OpenFoodFacts barcode
  usdaFdcId       String? // USDA FoodData Central ID
  fatSecretFoodId String? // FatSecret food_id

  @@index([userId])
  @@index([userId, useCount])
  @@index([barcode])
  @@unique([userId, offCode])
  @@unique([userId, usdaFdcId])
  @@unique([userId, fatSecretFoodId])
}

// ──────────────────────────────────────────
// RECIPES (tarifler)
// ──────────────────────────────────────────
model Recipe {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  photoUrl     String?
  servings     Int     @default(1)
  prepMinutes  Int?
  cookMinutes  Int?

  // Per-serving makrolar (cached, ingredients'tan hesaplanır)
  caloriesPerServing Float @default(0)
  proteinPerServing  Float @default(0)
  carbsPerServing    Float @default(0)
  fatPerServing      Float @default(0)

  ingredients RecipeIngredient[]
  steps       RecipeStep[]

  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([userId, useCount])
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId       String? // FoodItem reference
  customFoodId String? // CustomFood reference
  name         String
  quantity     Float
  unit         String // g | ml | piece | tbsp | tsp | cup
  calories     Float   @default(0)
  proteinG     Float   @default(0)
  carbsG       Float   @default(0)
  fatG         Float   @default(0)
  order        Int     @default(0)

  @@index([recipeId])
}

model RecipeStep {
  id          String @id @default(cuid())
  recipeId    String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order       Int
  description String

  @@index([recipeId])
}

// ──────────────────────────────────────────
// PANTRY / FRIDGE (mutfak stok)
// ──────────────────────────────────────────
model PantryItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String? // protein | sebze | meyve | süt | tahıl | baharat | içecek | diğer
  quantity     Float?
  unit         String? // g | adet | paket | şişe | kutu
  expiresAt    DateTime?
  photoUrl     String? // buzdolabı fotosu (varsa)
  source       String   @default("manual") // manual | photo_scan | barcode
  isLowStock   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, expiresAt])
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float?
  unit      String?
  category  String?
  isChecked Boolean  @default(false)
  source    String   @default("manual") // manual | recipe | low_stock
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isChecked])
}

// ──────────────────────────────────────────
// FAVORITES (kullanıcı favori yemekleri — long-press)
// ──────────────────────────────────────────
model FavoriteFood {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId       String? // FoodItem reference
  customFoodId String?
  recipeId     String?
  // External source references — OFF/USDA/FatSecret yemekleri direkt favorile
  offCode         String?
  usdaFdcId       String?
  fatSecretFoodId String?
  // Denormalized snapshot — hızlı liste + kaynak silinirse yine görünsün
  name        String
  brand       String?
  photoUrl    String?
  servingSize Float   @default(100)
  servingUnit String  @default("g")
  calories    Float   @default(0)
  proteinG    Float   @default(0)
  carbsG      Float   @default(0)
  fatG        Float   @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@unique([userId, offCode])
  @@unique([userId, usdaFdcId])
  @@unique([userId, fatSecretFoodId])
  @@unique([userId, foodId])
  @@unique([userId, customFoodId])
  @@unique([userId, recipeId])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web push
  webPushEnabled  Boolean @default(false)
  webPushEndpoint String?
  webPushAuth     String?
  webPushP256dh   String?

  // Mobile push
  mobilePushEnabled Boolean @default(false)
  expoPushToken     String?

  // Temel bildirimler
  waterReminder      Boolean @default(true)
  mealReminder       Boolean @default(true)
  medicationReminder Boolean @default(true)
  sleepReminder      Boolean @default(true)
  workoutReminder    Boolean @default(true)

  // Evcil hayvan & gamification
  petNotification  Boolean @default(true)
  streakWarning    Boolean @default(true)
  achievementAlert Boolean @default(true)
  roadmapUpdate    Boolean @default(true)

  // Akıllı bildirimler
  smartCalorie Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────
// WEARABLES
// ──────────────────────────────────────────

model WearableDevice {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // apple_watch | garmin | fitbit | google_fit | samsung_health
  brand          String
  model          String
  isConnected    Boolean   @default(false)
  lastSyncedAt   DateTime?
  accessToken    String?
  refreshToken   String?
  externalUserId String?

  readings WearableReading[]

  @@index([userId])
}

model WearableReading {
  id         String         @id @default(cuid())
  deviceId   String
  device     WearableDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // heart_rate | steps | calories_burned | sleep_minutes | hrv | spo2
  value      Float
  unit       String
  recordedAt DateTime

  @@index([userId])
  @@index([deviceId])
  @@index([recordedAt])
}

// ──────────────────────────────────────────
// AI CONVERSATIONS
// ──────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   String // program_generation | workout_coaching | nutrition_advice | health_assessment
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ──────────────────────────────────────────
// FORM ANALYSIS & ANALYTICS
// ──────────────────────────────────────────

// NEW TABLE: Store per-rep form analysis
model FormRepData {
  id        String         @id @default(cuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseName String
  repNumber    Int
  setNumber    Int

  // Pose data
  keypoints Json // Array of KeyPoint
  angles    Json // AngleData

  // Analysis results
  formScore            Float
  technicalCorrectness Float
  errors               Json // Array of FormError
  muscleEngagement     Json // MuscleEngagement map
  injuryRisk           Int // 1-100

  // Coach feedback
  voiceFeedback String
  corrections   String[]
  encouragement String

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([exerciseName])
  @@index([repNumber])
}

// NEW TABLE: Workout analytics aggregation
model WorkoutAnalytics {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  avgFormScore     Float
  bestRepScore     Float
  worstRepScore    Float
  formTrend        String // "improving", "declining", "stable"
  muscleEngagement Json // Aggregate muscle engagement
  weakPointsFound  String[]
  injuryRiskLevel  Int // 1-100
  riskFactors      String[]

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// NEW TABLE: User weaknesses tracking
model UserWeakness {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  muscleGroup    String // "posterior_chain", "rear_delts", etc.
  exerciseName   String
  severity       Int // 1-10
  discoveredDate DateTime  @default(now())
  targetDate     DateTime? // When to improve by

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([muscleGroup])
}

// ──────────────────────────────────────────
// PHASE 2: USER PROFILING & ANALYTICS
// ──────────────────────────────────────────

// User Profile - Basic Info
model UserBasicProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  age                Int?
  gender             String? // Male, Female, Other, Prefer not to say
  height             Float? // cm
  weight             Float? // kg
  fitnessLevel       String? // Beginner, Intermediate, Advanced, Elite
  primaryGoal        String? // Weight Loss, Muscle Gain, Strength, etc
  experienceYears    Int?
  targetWeight       Float?
  targetFitnessLevel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Health & Injury Tracking
model UserHealthMetrics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeInjuries      Json? // Array<{bodyPart, injuryType, severity, onsetDate, recoveryDeadline, restrictions}>
  pastInjuries        Json? // Array<{bodyPart, injuryType, onsetDate, recoveryDate, notes}>
  medicalRestrictions String[]
  currentPainPoints   Json? // Array<{bodyPart, painLevel, occurrence}>
  doctorNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Training History
model UserTrainingHistory {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingDaysPerWeek Int?
  preferredExercises  String[]
  dislikedExercises   String[]
  personalRecords     Json? // Array<{exercise, weight_kg, reps, date}>
  startingStats       Json? // {fitnessLevel, weight_kg, strengthBaseline}
  trainingStyle       String? // Push/Pull/Legs, Upper/Lower, Full Body, PPL, Bro Split
  preferredDuration   Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Nutrition & Recovery Targets
model UserNutritionMetrics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  proteinTarget      Float? // grams/day
  calorieTarget      Int?
  dietType           String? // Omnivore, Vegetarian, Vegan, Keto, Paleo, Other
  avgSleepHours      Float?
  stressLevel        Int? // 1-10
  alcoholConsumption String? // None, Occasional, Regular, Daily
  smoking            Boolean?
  waterIntakeTarget  Float? // liters/day
  supplementStack    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Daily Metrics - Post-workout check-in
model DailyMetrics {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  date          DateTime @default(now())
  sleepHours    Float
  sleepQuality  Int // 1-10
  stressLevel   Int // 1-10
  proteinIntake Float // grams
  calorieIntake Int?
  waterIntake   Float // liters
  mood          String // Excellent, Good, Neutral, Poor
  energyLevel   Int // 1-10
  soreness      Int // 1-10
  injuryPain    Int // 1-10
  notes         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([sessionId])
}

// ──────────────────────────────────────────
// SOCIAL FEATURES
// ──────────────────────────────────────────

model UserFriend {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  status      String    @default("pending") // pending, accepted, blocked
  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@index([userId, status])
}

model UserActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityType String // "workout_completed", "pr_achieved", "streak_milestone"
  description  String // "Benched 120kg x5", "10 day streak"
  metadata     Json? // {exercise, weight, reps, streak_days, formScore}

  createdAt  DateTime @default(now())
  visibility String   @default("friends_only") // private, friends_only, public

  @@index([userId])
  @@index([createdAt])
  @@index([activityType])
  @@index([visibility])
  @@index([userId, createdAt])
}

model Leaderboard {
  id String @id @default(cuid())

  leaderboardType String // "form_score", "most_consistent", "strongest", "best_recovery"
  period          String // "weekly", "monthly", "all_time"

  entries Json // Array<{userId, username, score, rank, trend}>

  updatedAt DateTime @updatedAt

  @@unique([leaderboardType, period])
  @@index([leaderboardType])
  @@index([updatedAt])
}

// ──────────────────────────────────────────
// SUBSCRIPTION
// ──────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  tier                 String    @default("free") // free | basic | standard | pro
  status               String    @default("active") // active | canceled | past_due
  currentPeriodEnd     DateTime?
  monthlySessionsUsed  Int       @default(0)
  aiProgramsUsed       Int       @default(0)
  aiMealsUsed          Int       @default(0)
  aiCoachUsed          Int       @default(0)
  usageResetAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────
// V2: MEMORY EMBEDDINGS & CHALLENGE GROUPS
// ──────────────────────────────────────────

model UserMemoryEmbedding {
  id         String                       @id @default(cuid())
  userId     String
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")?
  type       String // MemoryType values stored as strings
  importance Int                          @default(5) // 1-10 scale
  decayScore Float                        @default(1.0) // exponential decay: 0-1
  tags       String[]
  sourceId   String?
  sourceType String?
  createdAt  DateTime                     @default(now())
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ChallengeGroup {
  id           String       @id @default(cuid())
  weekStart    DateTime
  ageRange     String
  fitnessLevel FitnessLevel
  goal         FitnessGoal
  avgSessions  Float        @default(0)
  memberCount  Int          @default(0)
  updatedAt    DateTime     @updatedAt
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
}

enum NotificationType {
  water
  meal
  medication
  sleep
  workout
  pet
  streak
  achievement
  roadmap
  system
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ──────────────────────────────────────────
// PHASE 2: WEARABLES, SLEEP, READINESS, SUMMARIES
// ──────────────────────────────────────────

model Wearable {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserWearables", fields: [userId], references: [id], onDelete: Cascade)
  type         String // "APPLE_HEALTH", "GARMIN", "FITBIT"
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  isActive     Boolean   @default(false)
  connectedAt  DateTime  @default(now())
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model SleepRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserSleepRecords", fields: [userId], references: [id], onDelete: Cascade)
  duration   Float // minutes
  quality    Float // 0-100
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([recordedAt])
}

model SleepSession {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("UserSleepSessions", fields: [userId], references: [id], onDelete: Cascade)
  status          String       @default("active") // active | completed | cancelled
  startedAt       DateTime
  endedAt         DateTime?
  plannedAlarmAt  DateTime?
  smartAlarm      Boolean      @default(true) // 30dk pencerede light evrede uyandır
  actualAlarmAt   DateTime?
  bedtimeBpm      Float?
  bedtimeHrv      Float?
  wakeBpm         Float?
  wakeHrv         Float?
  totalMinutes    Float?
  sleepScore      Int? // 0-100
  awakeMinutes    Float        @default(0)
  lightMinutes    Float        @default(0)
  deepMinutes     Float        @default(0)
  remMinutes      Float        @default(0)
  snoreCount      Int          @default(0)
  snoreMinutes    Float        @default(0)
  movementCount   Int          @default(0)
  avgDb           Float?
  peakDb          Float?
  musicTrackId    String?
  musicTrack      SleepMusicTrack? @relation(fields: [musicTrackId], references: [id])
  sleepTimerMin   Int?
  wearableSynced  Boolean      @default(false)
  dataSource      String       @default("estimated") // wearable | estimated
  notes           String?
  events          SleepEvent[]
  snippets        SleepSnippet[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@index([userId, status])
}

model SleepEvent {
  id          String       @id @default(cuid())
  sessionId   String
  session     SleepSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String // snore | movement | wake | stage_change | noise_peak
  timestamp   DateTime
  value       Float? // dB / accel-delta / stage code
  stage       String? // awake | light | deep | rem
  durationSec Int?

  @@index([sessionId])
  @@index([sessionId, type])
}

model SleepSnippet {
  id          String       @id @default(cuid())
  sessionId   String
  session     SleepSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileUrl     String
  durationSec Int
  peakDb      Float
  recordedAt  DateTime
  category    String // snore | noise

  @@index([sessionId])
}

model DreamConversation {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation("UserDreamConversations", fields: [userId], references: [id], onDelete: Cascade)
  title     String          @default("Yeni Rüya")
  messages  DreamMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

model DreamMessage {
  id             String            @id @default(cuid())
  conversationId String
