{
  "buildCommand": "pnpm install && pnpm build",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/morning-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/smart-notification",
      "schedule": "0 18 * * *"
    }
  ]
}
