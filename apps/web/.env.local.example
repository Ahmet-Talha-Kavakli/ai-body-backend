# ──────────────────────────────────────────
# Clerk Authentication
# Get these from https://dashboard.clerk.com
# ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_your_key_here
CLERK_SECRET_KEY=sk_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ──────────────────────────────────────────
# Database (Supabase)
# Get these from https://supabase.com/dashboard → Connect → ORM → Prisma
# ──────────────────────────────────────────
DATABASE_URL=postgresql://your_user:your_password@your_host.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://your_user:your_password@your_host.supabase.com:5432/postgres

# ──────────────────────────────────────────
# Upstash Redis
# Get these from https://console.upstash.com
# ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ──────────────────────────────────────────
# OpenAI
# Get from https://platform.openai.com/api-keys
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ──────────────────────────────────────────
# Stripe Payments
# Get from https://dashboard.stripe.com
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_BASIC_PRICE_ID=price_your_id_here
STRIPE_STANDARD_PRICE_ID=price_your_id_here
STRIPE_PRO_PRICE_ID=price_your_id_here

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
